[Unit]
Description=Supermarche Gunicorn daemon
After=network.target

[Service]
User=django
Group=www-data
WorkingDirectory=/home/django/supermarche/Misges
EnvironmentFile=/home/django/supermarche/.env
ExecStart=/home/django/supermarche/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/run/gunicorn.sock \
    --access-logfile /var/log/gunicorn/access.log \
    --error-logfile /var/log/gunicorn/error.log \
    --timeout 120 \
    supermarket.wsgi:application

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
